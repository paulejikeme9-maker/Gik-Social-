
const posts = document.getElementById('posts');
const form = document.getElementById('post-form');
const input = document.getElementById('post-text');
const title = document.getElementById('page-title');

const savedPosts = [];
const friends = [
  { name: 'Discover People', detail: 'Find people to connect with on Gik.' }
];
const groups = [
  { name: 'Welcome to Gik Community', detail: 'A place for everyone to connect.' }
];

function showMessage(message) {
  posts.replaceChildren();

  const card = document.createElement('article');
  card.className = 'card';

  const text = document.createElement('p');
  text.textContent = message;

  card.append(text);
  posts.append(card);
}

function addPost(message) {
  const card = document.createElement('article');
  card.className = 'card';

  const text = document.createElement('p');
  text.textContent = message;

  const like = document.createElement('button');
  like.textContent = 'Like';

  const count = document.createElement('span');
  count.textContent = ' 0 likes';

  like.addEventListener('click', () => {
    const liked = like.dataset.liked === 'yes';
    like.dataset.liked = liked ? 'no' : 'yes';
    like.textContent = liked ? 'Like' : 'Liked';
    count.textContent = liked ? ' 0 likes' : ' 1 like';
  });

  const save = document.createElement('button');
  save.textContent = 'Save';

  save.addEventListener('click', () => {
    if (!savedPosts.includes(message)) {
      savedPosts.push(message);
    }
    save.textContent = 'Saved';
  });

  card.append(text, like, count, save);
  posts.prepend(card);
}

function showHome() {
  posts.replaceChildren();
  addPost('Welcome to Gik! Your global social community starts here.');
}

function showVideos() {
  showMessage(
    'Gik Videos: This section is ready for us to build. Video uploads and playback are not connected yet.'
  );
}

function showFriends() {
  posts.replaceChildren();

  friends.forEach(friend => {
    const card = document.createElement('article');
    card.className = 'card';

    const name = document.createElement('h3');
    name.textContent = friend.name;

    const detail = document.createElement('p');
    detail.textContent = friend.detail;

    card.append(name, detail);
    posts.append(card);
  });
}

function showGroups() {
  posts.replaceChildren();

  groups.forEach(group => {
    const card = document.createElement('article');
    card.className = 'card';

    const name = document.createElement('h3');
    name.textContent = group.name;

    const detail = document.createElement('p');
    detail.textContent = group.detail;

    card.append(name, detail);
    posts.append(card);
  });
}

function showSaved() {
  posts.replaceChildren();

  if (savedPosts.length === 0) {
    showMessage('You have not saved any posts yet.');
    return;
  }

  savedPosts.forEach(addPost);
}

const pageActions = {
  home: showHome,
  video: showVideos,
  videos: showVideos,
  friends: showFriends,
  groups: showGroups,
  saved: showSaved
};

document.querySelectorAll('[data-page]').forEach(button => {
  button.addEventListener('click', () => {
    const page = button.dataset.page.toLowerCase();
    title.textContent =
      page.charAt(0).toUpperCase() + page.slice(1);

    if (pageActions[page]) {
      pageActions[page]();
    } else {
      showMessage(
        `${title.textContent}: This section has not been built yet.`
      );
    }
  });
});

form.addEventListener('submit', event => {
  event.preventDefault();

  const message = input.value.trim();
  if (!message) return;

  addPost(message);
  input.value = '';
});

showHome();

                        
